<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url><loc>{{ url('home') }}</loc><priority>1.0</priority></url>
    <url><loc>{{ url('client') }}</loc><priority>0.9</priority></url>
{% for project in projects %}
    <url><loc>{{ url('projects_details', {slug: project.slug}) }}</loc></url>
    {# version « création de site » seulement si elle a son propre texte (sinon canonical vers la première) #}
    {% if project.hasClientDescription %}
    <url><loc>{{ url('client_projects_details', {slug: project.slug}) }}</loc></url>
    {% endif %}
{% endfor %}
</urlset>
