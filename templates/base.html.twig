<!DOCTYPE html>
<html lang="fr">
    <head>
        {# balises SEO rendues côté serveur à partir de la prop "seo" (ProjectsController) #}
        {% set seo = page.props.seo ?? {} %}
        {% set seo_title = seo.title ?? 'Sylvain Pillet – Développeur web freelance' %}
        {% set seo_description = seo.description ?? '' %}
        {% set route = app.request.attributes.get('_route') %}
        {# seo.canonical : page qui répète une autre (projet sans texte « création de site ») #}
        {% set canonical = seo.canonical ?? (route ? url(route, app.request.attributes.get('_route_params')) : null) %}
        {% set profile_image = absolute_url(asset('images/sylvain-pillet.jpg')) %}
        {# visuel propre à la page (capture d'un projet), sinon la photo de profil #}
        {% set share = seo.image ?? {url: asset('images/sylvain-pillet.jpg'), width: 421, height: 500, alt: 'Sylvain Pillet, développeur web freelance React et frontend à Toulouse'} %}
        {% set share_image = absolute_url(share.url) %}

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ seo_title }}</title>
        <meta name="description" content="{{ seo_description }}">
        <meta name="author" content="Sylvain Pillet">
        <meta name="robots" content="{{ seo.robots ?? 'index, follow' }}">
        {% if canonical %}
        <link rel="canonical" href="{{ canonical }}">
        {% endif %}

        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <meta name="theme-color" content="#36013f">

        <meta name="geo.region" content="FR-31">
        <meta name="geo.placename" content="Toulouse">
        <meta name="geo.position" content="43.6045;1.4442">
        <meta name="ICBM" content="43.6045, 1.4442">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Sylvain Pillet">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ seo_title }}">
        <meta property="og:description" content="{{ seo_description }}">
        {% if canonical %}
        <meta property="og:url" content="{{ canonical }}">
        {% endif %}
        <meta property="og:image" content="{{ share_image }}">
        <meta property="og:image:width" content="{{ share.width }}">
        <meta property="og:image:height" content="{{ share.height }}">
        <meta property="og:image:alt" content="{{ share.alt }}">
        {# grande carte pour les visuels paysage, "summary" pour la photo portrait #}
        <meta name="twitter:card" content="{{ (seo.image ?? null) ? 'summary_large_image' : 'summary' }}">
        <meta name="twitter:title" content="{{ seo_title }}">
        <meta name="twitter:description" content="{{ seo_description }}">
        <meta name="twitter:image" content="{{ share_image }}">

        <script type="application/ld+json">
            {{ {
                '@context': 'https://schema.org',
                '@type': 'Person',
                '@id': url('home') ~ '#sylvain-pillet',
                'name': 'Sylvain Pillet',
                'url': url('home'),
                'image': profile_image,
                'jobTitle': 'Développeur web freelance – React & Frontend',
                'description': 'Développeur web freelance à Toulouse, spécialisé React et frontend : interfaces modernes, performance web et SEO technique. Missions sur place ou en full remote.',
                'knowsAbout': ['React', 'TypeScript', 'JavaScript', 'Développement frontend', 'Performance web', 'SEO technique', 'UI/UX', 'Symfony', 'PHP'],
                'address': {'@type': 'PostalAddress', 'addressLocality': 'Toulouse', 'addressRegion': 'Occitanie', 'addressCountry': 'FR'},
                'sameAs': ['https://github.com/sylpi10', 'https://www.linkedin.com/in/sylvain-pillet'],
            }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
        </script>
        {# activité, telle que déclarée sur la fiche Google Business : mêmes nom, téléphone
           et ville que la fiche et les mentions légales (cohérence du référencement local) ;
           priceRange : premier tarif de la page création de site (Pricing.tsx) #}
        <script type="application/ld+json">
            {{ {
                '@context': 'https://schema.org',
                '@type': 'ProfessionalService',
                '@id': url('home') ~ '#activite',
                'name': 'Sylvain Pillet',
                'description': 'Développeur web freelance à Toulouse : création de sites vitrines, refontes et applications web React / Symfony, sur place ou à distance partout en France.',
                'url': url('home'),
                'image': profile_image,
                'telephone': '+33688103175',
                'priceRange': 'À partir de 1 500 €',
                'address': {'@type': 'PostalAddress', 'postalCode': '31400', 'addressLocality': 'Toulouse', 'addressRegion': 'Occitanie', 'addressCountry': 'FR'},
                'geo': {'@type': 'GeoCoordinates', 'latitude': 43.6045, 'longitude': 1.4442},
                'areaServed': [{'@type': 'City', 'name': 'Toulouse'}, {'@type': 'Country', 'name': 'France'}],
                'founder': {'@id': url('home') ~ '#sylvain-pillet'},
                'sameAs': ['https://share.google/cjVgdToR7DqgAuS4P'],
            }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
        </script>

        {# polices au-dessus de la ligne de flottaison : chargées tôt pour limiter le décalage (CLS) #}
        <link rel="preload" href="{{ asset('assets/static/fonts/effortless.woff2', 'vite') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('assets/static/fonts/Montserrat-Regular.woff2', 'vite') }}" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}
             {{ vite_entry_link_tags('styles') }}
        {% endblock %}

        {% block javascripts %}
        {{ inertiaHead(page) }}
        {{ vite_entry_script_tags('app', { dependency: 'react' }) }}
        {% endblock %}

        {# Matomo sans cookies (exemption CNIL : pas de bandeau), en production seulement
           (MATOMO_URL vide ailleurs). Première page comptée ici ; les navigations Inertia,
           qui ne rechargent pas la page, le sont dans assets/lib/analytics.ts #}
        {% if matomo_url %}
        {% set matomo_base = matomo_url|trim('/', 'right') ~ '/' %}
        <script>
            var _paq = window._paq = window._paq || [];
            _paq.push(['disableCookies']);
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            _paq.push(['setTrackerUrl', {{ (matomo_base ~ 'matomo.php')|json_encode|raw }}]);
            _paq.push(['setSiteId', {{ matomo_site_id|json_encode|raw }}]);
        </script>
        <script async src="{{ matomo_base }}matomo.js"></script>
        {% endif %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {{ inertia(page) }}
    </body>
</html>
